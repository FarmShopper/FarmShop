    <style>
      .opcje-wyboru {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        padding: 0 10%;
      }

      .opcje-wyboru a {
        font-size: 1.2em;
        font-weight: bold;
        text-decoration: none;
      }

      .opcje-wyboru a:hover {
        color: #0077cc;
      }
    </style>
