    <link rel="stylesheet" href="style.css" type="text/css">
    <style>
      section {
        padding: 20px;
      }

      ul {
        list-style-type: none;
        padding-left: 0;
      }

      li {
        margin-bottom: 10px;
      }

      a.produkt-link {
        font-weight: bold;
        font-size: 1.1em;
        text-decoration: none;
        color: #0077cc;
      }

      a.produkt-link:hover {
        text-decoration: underline;
        color: #005fa3;
      }
    </style>
  </head>
  <body>
	<header>
		<img src="images/Logo.png">
	</header>
    <nav>
 <ul class="menu" id="menu">
